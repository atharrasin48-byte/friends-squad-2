rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "gGs0iwpHP0W3Al37lFHqV6DZg0J2";
    }
    function tenderIsOpen() {
      return !exists(/databases/$(database)/documents/registrationSettings/main)
        || get(/databases/$(database)/documents/registrationSettings/main).data.tenderLocked != true;
    }
    match /visitorStats/{visitorId} {
      allow read: if true;
      allow create: if visitorId.matches('^[a-zA-Z0-9]{1,40}$')
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /visitorDaily/{visitId} {
      allow read: if true;
      allow create: if visitId.matches('^[a-zA-Z0-9]{1,40}_[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['date', 'createdAt'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{8}$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /members/{memberId} { allow read: if true; allow write: if isAdmin(); }
    match /notices/{noticeId} { allow read: if true; allow write: if isAdmin(); }
    match /media/{mediaId} { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{settingsId} { allow read: if true; allow write: if isAdmin(); }
    match /memberApplications/{memberKey} {
      allow create: if request.auth != null
        && memberKey.matches('^[a-f0-9]{64}$')
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/approvedMemberKeys/$(memberKey))
        && request.resource.data.keys().hasAll(['uid','email','name','birthDate','status','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','email','name','birthDate','status','createdAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.birthDate is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if isAdmin();
    }
    match /approvedMemberKeys/{memberKey} { allow read, write: if isAdmin(); }
    match /memberRegistrationNumbers/{registrationNo} { allow read, write: if isAdmin(); }
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /userProfiles/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','username','age','email','photoURL','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9._]{3,20}
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /tenderApplications/{applicationId} {
      allow create: if tenderIsOpen()
        && request.resource.data.keys().hasAll(['serial','name','address','collectionDate','submissionDate','place','tenderName','phone','date','imageUrl','createdAt'])
        && request.resource.data.keys().hasOnly(['serial','name','address','collectionDate','submissionDate','place','tenderName','phone','date','imageUrl','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.phone is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if isAdmin();
    }
    match /gameRooms/{roomCode} {
      allow read: if request.auth != null
        && (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid || resource.data.guestUid == null);
      allow create: if request.auth != null
        && roomCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['code','hostUid','hostName','guestUid','guestName','board','turn','winner','createdAt','updatedAt'])
        && request.resource.data.code == roomCode
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 18
        && request.resource.data.guestUid == null && request.resource.data.guestName == null
        && request.resource.data.board == ['','','','','','','','','']
        && request.resource.data.turn == 'X' && request.resource.data.winner == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['code','hostUid','hostName','guestUid','guestName','board','turn','winner','createdAt','updatedAt'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.board is list && request.resource.data.board.size() == 9
        && request.resource.data.board.hasOnly(['','X','O'])
        && request.resource.data.turn in ['X','O']
        && (request.resource.data.winner == null || request.resource.data.winner in ['X','O','draw'])
        && request.resource.data.updatedAt == request.time
        && ((resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 18
          && request.resource.data.board == resource.data.board
          && request.resource.data.turn == resource.data.turn
          && request.resource.data.winner == resource.data.winner)
          || (resource.data.guestUid == request.resource.data.guestUid
          && resource.data.guestName == request.resource.data.guestName));
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
    match /registrationSettings/{settingsId} { allow read: if true; allow write: if isAdmin(); }
  }
})
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','age','photoURL','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /memberAccounts/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /tenderApplications/{applicationId} {
      allow create: if tenderIsOpen()
        && request.resource.data.keys().hasAll(['serial','name','address','collectionDate','submissionDate','place','tenderName','phone','date','imageUrl','createdAt'])
        && request.resource.data.keys().hasOnly(['serial','name','address','collectionDate','submissionDate','place','tenderName','phone','date','imageUrl','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.phone is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if isAdmin();
    }
    match /gameRooms/{roomCode} {
      allow read: if request.auth != null
        && (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid || resource.data.guestUid == null);
      allow create: if request.auth != null
        && roomCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['code','hostUid','hostName','guestUid','guestName','board','turn','winner','createdAt','updatedAt'])
        && request.resource.data.code == roomCode
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 18
        && request.resource.data.guestUid == null && request.resource.data.guestName == null
        && request.resource.data.board == ['','','','','','','','','']
        && request.resource.data.turn == 'X' && request.resource.data.winner == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['code','hostUid','hostName','guestUid','guestName','board','turn','winner','createdAt','updatedAt'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.board is list && request.resource.data.board.size() == 9
        && request.resource.data.board.hasOnly(['','X','O'])
        && request.resource.data.turn in ['X','O']
        && (request.resource.data.winner == null || request.resource.data.winner in ['X','O','draw'])
        && request.resource.data.updatedAt == request.time
        && ((resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 18
          && request.resource.data.board == resource.data.board
          && request.resource.data.turn == resource.data.turn
          && request.resource.data.winner == resource.data.winner)
          || (resource.data.guestUid == request.resource.data.guestUid
          && resource.data.guestName == request.resource.data.guestName));
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
    match /registrationSettings/{settingsId} { allow read: if true; allow write: if isAdmin(); }
  }
}